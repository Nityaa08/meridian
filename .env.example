# Free key at https://console.groq.com -> API Keys. Leave empty to run without one:
# `make demo` then simulates the LLM stages (a placeholder value here would be sent
# to Groq as a real key and every LLM stage would fail with 401).
GROQ_API_KEY=
# Current Groq models: https://console.groq.com/docs/models (checked 2026-11-02)
GROQ_MODEL=openai/gpt-oss-20b
# Embedder device: "cpu" (default, safe on Apple Silicon), "cuda", or empty for auto
EMBEDDER_DEVICE=cpu
# Set before exposing the full service: research, follow-ups, deletes and /sessions
# then need 'Authorization: Bearer <key>' or 'X-API-Key: <key>'. Unset = open.
API_KEY=
# Longest question or follow-up accepted (characters)
MAX_QUERY_CHARS=1000
# Research runs + follow-ups per client IP per hour, per worker process (0 = off)
RESEARCH_RATE_LIMIT_PER_HOUR=30
# Deadline for one whole research run or follow-up, in seconds (0 = off)
SESSION_TIMEOUT_S=180

# Where sessions are stored (the full service). SQLite by default.
DATABASE_URL=sqlite+aiosqlite:///./meridian.db
# "sentence-transformers" (needs requirements-ml.txt, PyTorch) or "hashing" (lexical, no PyTorch)
EMBEDDER_BACKEND=sentence-transformers

# Demo app only (what the live site runs; `make demo` sets DEMO_MODE and the hashing embedder)
DEMO_MODE=false
DEMO_RATE_LIMIT_PER_HOUR=12
DEMO_MAX_QUERY_CHARS=200
